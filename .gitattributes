# Model buffers, textures, audio and fonts must retain their exact bytes.
*.bin binary
*.glb binary
*.png binary
*.webp binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary

# Unified patches and profiling captures preserve their original whitespace.
tools/**/*.patch -whitespace
tools/**/perf-symbols.txt -whitespace
# Test output keeps its terminal blank lines as captured evidence.
tools/benchmarks/results/**/*.log -whitespace
